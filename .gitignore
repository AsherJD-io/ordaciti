# Environment / secrets
.env
.env.*
!.env.example

# Node
node_modules/
.next/
out/
.vercel/

# TypeScript build artifacts
next-env.d.ts
tsconfig.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs / temporary files
*.log
*.tmp
tmp/
temp/

# Generated datasets — raw source data and unsupported outputs stay ignored
data/raw/
data/AI_cache/

# Processed datasets required for deployment
# Pattern: ignore all files in data/processed/, then un-ignore the four required ones
data/processed/*
!data/processed/evidence.json
!data/processed/normalized_projects.json
!data/processed/patterns.json
!data/processed/signals.json

# Other processed outputs (not required at build time) — stay ignored
data/processed/ingestion_validation.json
data/processed/population.json
data/processed/projects.json

# Generated media
public/screenshots/generated/

# Credentials
credentials.json
service-account*.json
*.pem
*.key
